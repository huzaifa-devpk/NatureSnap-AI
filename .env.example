# NatureSnap AI Environment Configuration
# Optional: Hugging Face User Access Token for open-weight Gemma inference
# Get your free token at: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=

# Optional: Default open-weight model (e.g., google/gemma-2-2b-it, google/paligemma-3b-pt-224)
VITE_OPEN_MODEL_NAME=google/gemma-2-2b-it

# Optional: Local Ollama endpoint
VITE_OLLAMA_ENDPOINT=http://localhost:11434
